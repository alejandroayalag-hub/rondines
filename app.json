{
  "expo": {
    "name": "Rondines ATA",
    "slug": "rondines-grupo-ata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.grupoata.rondines",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.grupoata.rondines",
      "infoPlist": {
        "NSCameraUsageDescription": "Se usa la cámara para escanear los códigos QR de los puntos de rondín.",
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación GPS para verificar que estás en el punto de rondín correcto."
      }
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00FF88",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c8f1aaa7-8ac8-463e-9c8c-093a5d03fc88"
      }
    },
    "owner": "alxpho"
  }
}
